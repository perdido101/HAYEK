# Supabase — the tenant boundary. RLS enforces org isolation on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role is used ONLY by the capture proxy to persist traces server-side.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional default judge model for llmJudge assertions (Phase 2).
HAYEK_JUDGE_MODEL=claude-haiku-4-5-20251001
